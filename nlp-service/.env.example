# News / fact-check APIs (optional — live feed uses these)
NEWS_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=

# Tier 3 LLM (optional). Free key: https://console.groq.com/keys
# Without this, /verify still works via Tier 1 + Tier 2 (Hugging Face BART).
GROQ_API_KEY=
# Optional override if Groq renames models again
GROQ_MODEL=openai/gpt-oss-120b

# Install torch separately (CPU is fine):
#   pip install torch
